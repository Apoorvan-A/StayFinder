# Backend configuration
# SQLAlchemy database URL. Defaults to a local SQLite file next to the app.
DATABASE_URL=sqlite:///./app.db

# Comma-separated list of allowed CORS origins (the frontend URL).
CORS_ORIGINS=http://localhost:3000

# Set to "1" to seed the database on startup when empty.
SEED_ON_STARTUP=1

# --- Auth / sessions ---
# Secret used to sign the HttpOnly session cookie. Generate a strong value in production,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=dev-insecure-secret-change-me

# Cookie flags. In production (HTTPS, cross-site frontend) use:
#   COOKIE_SECURE=1 and COOKIE_SAMESITE=none
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# Google OAuth client ID (from Google Cloud Console → Credentials → OAuth client, Web).
# Leave blank to disable Google sign-in; demo access still works without it.
GOOGLE_CLIENT_ID=

# Public origin used to build links inside outgoing emails.
FRONTEND_URL=http://localhost:3000

# --- AI Concierge (optional) ---
# Leave AI_API_KEY blank to use the built-in deterministic parser (no external calls).
# When set, natural-language requests are parsed by the LLM into a structured search intent.
AI_PROVIDER=          # e.g. gemini
AI_API_KEY=
AI_MODEL=             # e.g. gemini-2.0-flash (defaults to gemini-2.0-flash)

# --- Transactional email (optional) ---
# Leave EMAIL_API_KEY blank locally — bookings still succeed and delivery is simply skipped.
# StayFinder sends mail FROM this provider TO the authenticated user's email (never via Gmail).
EMAIL_PROVIDER=       # e.g. resend
EMAIL_API_KEY=
EMAIL_FROM=StayFinder <onboarding@resend.dev>
