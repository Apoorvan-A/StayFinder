# Backend configuration
# SQLAlchemy database URL. Defaults to a local SQLite file next to the app.
DATABASE_URL=sqlite:///./app.db

# Comma-separated list of allowed CORS origins (the frontend URL).
CORS_ORIGINS=http://localhost:3000

# Set to "1" to seed the database on startup when empty.
SEED_ON_STARTUP=1

# --- Auth / sessions ---
# Secret used to sign the HttpOnly session cookie. Generate a strong value in production,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=dev-insecure-secret-change-me

# Cookie flags. In production (HTTPS, cross-site frontend) use:
#   COOKIE_SECURE=1 and COOKIE_SAMESITE=none
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# Google OAuth client ID (from Google Cloud Console → Credentials → OAuth client, Web).
# Leave blank to disable Google sign-in; demo access still works without it.
GOOGLE_CLIENT_ID=
